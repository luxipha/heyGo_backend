project_id             = "heygo-ng"
region                 = "europe-west1"
github_repository      = "luxipha/heyGo_backend"
github_repository_id   = "1369862034"
github_owner_id        = "202601895"
github_deploy_branch   = "main"
artifact_repository_id = "heygo"

# Phase 1 creates Cloud SQL and Secret Manager containers only.
deploy_services                     = false
retain_pull_subscriber_permissions = true
cloud_sql_tier                      = "db-f1-micro"

# Set this after the PR merges and all five images are published. It creates
# the migration job while deploy_services remains false.
# image_tag = "0123456789abcdef0123456789abcdef01234567"

# Populate the external secret versions documented in README.md, then set these
# values for the controlled Phase 2 Cloud Run deployment.
# deploy_services = true
# allowed_origins  = "https://app.example.com,https://admin.example.com"
# app_url          = "https://app.example.com"

# After authenticated push delivery has been deployed and verified, set this
# to false in a separate cleanup plan.
# retain_pull_subscriber_permissions = false
