# Template for local development. Copy to .env.local and fill in real values.
#
#   cp .env.local.example .env.local
#
# .env.local is gitignored. Never commit real credentials.

# Postgres with PostGIS. Prefer the DIRECT endpoint (no "-pooler"): migrations
# take a session-level advisory lock, which PgBouncer transaction mode does not
# guarantee. Production requires TLS, so keep sslmode=require.
DATABASE_URL='postgresql://user:password@host:5432/dbname?sslmode=require'

# Pub/Sub project. For local emulation also set PUBSUB_EMULATOR_HOST, for
# example localhost:8085. In Google Cloud, Application Default Credentials come
# from the service's runtime identity.
GCP_PROJECT_ID='heygo-ng'
PUBSUB_EMULATOR_HOST='localhost:8085'

# Shared secret for service-to-service gRPC calls.
INTERNAL_SERVICE_TOKEN='change-me'

# CasperID business app credentials. api-gateway /ready stays 503 without these.
CASPERID_APP_ID=''
CASPERID_API_SECRET=''

# Private Cloudflare R2 bucket for HeyGo operational documents. Use an R2 API
# token scoped to this bucket. R2_ENDPOINT includes the account endpoint.
R2_ENDPOINT='https://ACCOUNT_ID.r2.cloudflarestorage.com'
R2_BUCKET='heygo-driver-documents'
R2_ACCESS_KEY_ID=''
R2_SECRET_ACCESS_KEY=''

# Staff review sessions. Keep ADMIN_COOKIE_SECURE=true on HTTPS deployments.
ADMIN_COOKIE_SECURE=false
ADMIN_COOKIE_DOMAIN=''
ADMIN_COOKIE_SAME_SITE='lax'

# Encryption key for secrets entered in Admin (for example the Resend API key).
# Generate with: openssl rand -hex 32
HEYGO_ADMIN_SETTINGS_KEY=''

# Optional Firebase Cloud Messaging HTTP v1 service-account JSON (mounted as
# a secret file). Without
# this, Driver inbox and live socket events still work, but push delivery waits.
FCM_SERVICE_ACCOUNT_FILE=''
FCM_PROJECT_ID=''
# Enable Rider delivery only after its Firebase project and installed app are verified.
HEYGO_RIDER_PUSH_ENABLED=false

# Monnify credentials. payment-service /ready stays 503 without these.
MONNIFY_API_KEY=''
MONNIFY_SECRET_KEY=''
MONNIFY_CONTRACT_CODE=''

# HTTP / gRPC wiring for running everything on one machine.
ALLOWED_ORIGINS='http://localhost:3000'
TRIP_SERVICE_URL='localhost:9000'
DRIVER_SERVICE_URL='localhost:9100'
OSRM_API='http://router.project-osrm.org/route/v1/driving'
# Explicit routing choice; Admin saved settings override this default.
GEO_ROUTE_PROVIDER='osrm'
# Backend-only key with Routes API enabled and permitted; inject via Secret Manager in production.
GOOGLE_ROUTES_API_KEY=''
# AMap Web Service key must have overseas access. Keep this server-only.
AMAP_ROUTES_API_KEY=''
HTTP_ADDR=':8080'
PAYMENT_HTTP_ADDR=':9200'
PAYMENT_SERVICE_URL='http://localhost:9200'

ENV='development'
ENVIRONMENT='development'

# Local scheduled-booking edit rollout; production defaults to disabled.
HEYGO_SCHEDULE_EDITS_ENABLED='true'

# Optional separate Ride Agent Gateway (off/unavailable until configured).
# Generate one server-only internal token and set it on both services.
RIDE_AGENT_URL='http://127.0.0.1:8085'
# Empty for local HTTP; deployed protected Cloud Run origin for identity tokens.
RIDE_AGENT_AUDIENCE=''
RIDE_AGENT_INTERNAL_TOKEN=''
RIDE_AGENT_PLACES_KEY=''
# Optional backend-only Geoapify fallback credential. Never send this to apps/Admin.
GEOAPIFY_API_KEY=''
# Search provider can also be selected in Admin Maps & navigation settings.
GEO_PLACE_PROVIDER='google'
# Public Nominatim is explicit user search only, max 1 request/sec across HeyGo.
# Apply migration 094; DATABASE_URL supplies its shared cache and request budget.
NOMINATIM_BASE_URL='https://nominatim.openstreetmap.org'
NOMINATIM_USER_AGENT='HeyGo/1.0 (+https://heygo.ng)'
RIDE_AGENT_LLM_ENABLED=false
RIDE_AGENT_PLANNER_URL=''
RIDE_AGENT_PLANNER_TOKEN=''

# Maximum vehicles per Driver (1-20); one active vehicle at a time.
DRIVER_MAX_VEHICLES=5

# Rider Discount/Incentive offers. Apply migrations 115-118 before enabling.
HEYGO_OFFERS_ENABLED=false

# Ideas integration: server-only token, disabled until both services are deployed.
HEYGO_IDEAS_ENABLED=false
HEYGO_IDEAS_URL=https://ideas.heygo.ng
HEYGO_IDEAS_BOARD=
HEYGO_IDEAS_TOKEN=
