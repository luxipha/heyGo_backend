project_id             = "heygo-ng"
region                 = "europe-west1"
github_repository      = "luxipha/heyGo_backend"
github_repository_id   = "1369862034"
github_owner_id        = "202601895"
github_deploy_branch   = "main"
artifact_repository_id = "heygo"

# Phase 1 creates Cloud SQL and Secret Manager containers only.
deploy_services                     = false
retain_pull_subscriber_permissions = true
cloud_sql_tier                      = "db-f1-micro"

# Set this after the PR merges and all six images are published. It creates
# the migration job while deploy_services remains false.
# image_tag = "0123456789abcdef0123456789abcdef01234567"

# Populate the external secret versions documented in README.md, then set these
# values for the controlled Phase 2 Cloud Run deployment.
# deploy_services = true
# allowed_origins  = "https://app.example.com,https://admin.example.com"
# admin_frontend_url = "https://admin.example.com"
# app_url          = "https://app.example.com"
# Configure Kudi and Resend/SMTP through Admin after migrations 062–063.
# Populate the server-only Places key secret; LLM planning stays disabled.

# After authenticated push delivery has been deployed and verified, set this
# to false in a separate cleanup plan.
# retain_pull_subscriber_permissions = false

# Preserve these already-enabled production features during infrastructure plans.
# r2_secret_version = "1"
# fcm_project_id    = "heygo-c5ae1"
# heroes_public_url = "https://hero.heygo.ng"

# Venue partner activation is separate from creating empty secret containers.
# Supply external secret versions privately before enabling either direction.
# venue_partner_url             = "https://partner.example.com"
# venue_partner_inbound_enabled = true

# Venue references are pinned to the versions verified by the config workflow.
# venue_partner_service_key_version = "1"
# venue_partner_inbound_key_version = "1"
# Keep false for the existing direct Payment secret configuration. Enabling it
# is a separate credentials change, not part of subscription restoration.
# payment_admin_settings_enabled = false
